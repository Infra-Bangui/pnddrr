# Copier vers .env (ne jamais committer .env).
# Sur Bangui : /opt/app/.env — le workflow ne déploie que docker-compose.yml.

# openssl rand -hex 32
SESSION_SECRET=

# Mot de passe du compte admin créé au premier démarrage (si /data est vide)
ADMIN_PASSWORD=

# 1 = afficher les comptes de démo et autoriser le seed 60 dossiers
PNDDRR_DEMO=0

# 1 = cookie Secure (uniquement derrière HTTPS, ex. pnddrr.datapr.org)
PNDDRR_SECURE_COOKIE=0
